  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jest": "^30.4.2"
  }
}
